# Copy to .env and fill in. Nothing here is required for Phase 1 (engine + tests).
# Phase 3 (live alert bot) reads these.

# Telegram alert bot (alert-only; the bot NEVER places orders)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_target_chat_id_here

# MetaTrader 5 terminal login (Phase 2 data extraction / Phase 3 live scan)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# OANDA v20 REST — real history download on a Mac (scripts/fetch_oanda_history.py)
# Free practice account token from https://www.oanda.com (Manage API Access).
OANDA_API_TOKEN=
OANDA_ENV=practice

# Paths
DATA_CACHE_DIR=data_cache
REPORTS_DIR=reports
STATE_DB_PATH=state/scalp_bot.db

# Prop account model to load from config/prop_rules.py
ACCOUNT_MODEL=fundingpips_2_step_phase_1
