# Consensus FX Sentinel - copy to .env and fill in.
#
# Placeholders only. Never commit real tokens or chat IDs.
# The Node runtime reads ONLY the FX_-prefixed variables below; it never falls
# back to the crypto bot's TELEGRAM_BOT_TOKEN, because two processes must not
# poll the same bot token.
#
# The fixture dry-run needs none of these:
#   node runtime/bot.js --dry-run --fixtures

# --- Telegram -------------------------------------------------------------
FX_TELEGRAM_BOT_TOKEN=
# Private chat seeded as the first alert target on first start only.
FX_TELEGRAM_CHAT_ID=
# Telegram user id allowed to run /scan, /activate and /deactivate.
FX_OWNER_TELEGRAM_USER_ID=

# --- Market data (read-only Tiingo Forex REST API) -------------------------
FX_TIINGO_API_TOKEN=

# --- Behaviour ------------------------------------------------------------
# Research mode is the default and cannot be bypassed while it is true.
FX_RESEARCH_MODE=true
# Journaling and outcome measurement continue even when sending is off.
FX_SEND_RESEARCH_ALERTS=false
FX_SYMBOLS=EUR_USD,GBP_USD,USD_JPY,XAU_USD
# Tiingo Free allows 50 requests/hour. One scan uses 17 requests, so the
# dependency-free REST runtime defaults to two scans/hour with quota headroom.
FX_SCAN_INTERVAL_SECONDS=1800
FX_OUTCOME_EXPIRY_HOURS=24
# Scanning pauses above this resident-memory ceiling; PM2 may use the same
# value as its restart backstop.
FX_MEMORY_CEILING_MB=180
FX_STATE_DIR=state
