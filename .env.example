TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# HTTPS URL used by the Telegram "View complete setup" button
SETUP_VIEWER_BASE_URL=https://your-viewer-domain.example
# Generate with: openssl rand -hex 32
SETUP_VIEWER_SECRET=
SETUP_VIEWER_PORT=3080
# Edge Bot research (comma-separated public Hyperliquid wallet addresses)
HYPERLIQUID_TRACKED_WALLETS=0xwallet1,0xwallet2
# Separate high-turnover / possible market-maker cohort (research only; never votes in the score)
HYPERLIQUID_LP_WALLETS=0xwallet3,0xwallet4
# Optional: use a separate Telegram bot so two polling processes do not compete
EDGE_TELEGRAM_BOT_TOKEN=
EDGE_TELEGRAM_CHAT_ID=
